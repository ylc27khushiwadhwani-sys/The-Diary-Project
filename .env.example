# Supabase Configuration
VITE_SUPABASE_URL=https://your-project-id.supabase.co
VITE_SUPABASE_ANON_KEY=your-anon-key-here

# Payments (all optional until the merchant account exists)
# Razorpay: after deploying the razorpay-order + razorpay-webhook edge functions, no key is needed in the browser build;
# the order endpoint returns the public key id. Set the endpoint so the site knows payments are live:
VITE_PAYMENTS_ORDER_URL=https://your-project-id.supabase.co/functions/v1/razorpay-order
# Buy-me-a-coffee: any hosted payment link (Razorpay Payment Link, Stripe Payment Link, etc.)
VITE_COFFEE_LINK=
# Display prices only (real amounts are set server side): shown in the pay-to-continue messages
VITE_LETTERS_PRICE_LABEL=
VITE_COMMUNITY_PRICE_LABEL=
